{
  "name": "gmc-medirecord",
  "productName": "Gayathri MediRecord",
  "version": "1.0.0",
  "description": "Private offline patient records for Gayathri Multi Speciality Clinic",
  "author": "Gayathri Multi Speciality Clinic",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:desktop": "vite build --mode desktop",
    "desktop": "vite build --mode desktop && electron .",
    "dist:win": "vite build --mode desktop && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "in.gayathriclinic.medirecord",
    "productName": "Gayathri MediRecord",
    "copyright": "© Gayathri Multi Speciality Clinic",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Gayathri-MediRecord-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Gayathri MediRecord",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "afterPack": "scripts/afterPack.cjs",
    "publish": null
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.73.0",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "^2.0.3",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.20.5"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
